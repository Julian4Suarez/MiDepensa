# Single source of truth for every environment variable the stack needs.
#
# Local:      cp .env.example .env.local   (make up does this for you)
# Staging /   built by scripts/deploy.sh from environments/<env>.manifest.env
# Production: plus environments/<env>.config.env

# ── Environment ─────────────────────────────────────────────
# local | staging | production — used to name containers.
ENV=local

# ── Images ──────────────────────────────────────────────────
# Pinned by digest for third-party images; app images are built locally.
POSTGRES_IMAGE=postgres:16-alpine
BACKEND_IMAGE=midepensa-backend
FRONTEND_IMAGE=midepensa-frontend

# ── Published ports (bound to 127.0.0.1) ────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=4200

# ── Database ────────────────────────────────────────────────
DB_USER=midepensa_user
DB_PASSWORD=midepensa_password
DB_NAME=midepensa_db

# ── Backend ─────────────────────────────────────────────────
AUTO_MIGRATE=true
CORS_ORIGINS=*
LOG_LEVEL=info
LOG_FORMAT=json

# ── Frontend ────────────────────────────────────────────────
# Reached by the browser, so it must be the host-visible URL.
PUBLIC_BACKEND_URL=http://localhost:8080/v1
