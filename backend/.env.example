# Copy to .env for local development: cp .env.example .env
#
# Values match backend/docker-compose.yml, so `make services-start && make dev`
# works with no edits.

# ── HTTP server ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Apply pending SQL migrations during startup.
AUTO_MIGRATE=true

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=midepensa_user
DB_PASSWORD=midepensa_password
DB_NAME=midepensa_db

# ── CORS ────────────────────────────────────────────────────
# Comma-separated origin allowlist. "*" is local development only.
CORS_ORIGINS=*

# ── Logging ─────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
# LOG_FORMAT: text | json
LOG_LEVEL=debug
LOG_FORMAT=text
